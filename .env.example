# Copy to .env and fill in. Never commit .env.

# --- Gnani (Prisma STT + Timbre TTS) -------------------------------------------------
# sent as X-API-Key-ID
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_WS_URL=wss://api.vachana.ai
# fill on Day 1 from the docs/console
GNANI_STT_MODEL=
GNANI_TTS_MODEL=timbre-v3.0          # v3.0: 13 voices that each speak all 10 languages; v2.5 has only 2 Kannada voices
STT_VAD_THRESHOLD=0.7                # telephony range 0.65–0.75 (verify header support on Day 1)
STT_MIN_SILENCE_MS=500               # telephony range 400–600

# --- Speech providers (pluggable; gnani is the default for both) -----------------------------
STT_PROVIDER=gnani                   # gnani | google | azure | elevenlabs | deepgram (overridable per agent/run)
TTS_PROVIDER=gnani
# optional default voice, e.g. Lakshmi
GNANI_TTS_VOICE=

# service-account key JSON on one line (Speech-to-Text v2 + Text-to-Speech APIs enabled)
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_SPEECH_LOCATION=us-central1   # chirp models are regional; "global" for older models
GOOGLE_STT_MODEL=chirp_2
# e.g. hi-IN-Neural2-A (optional default)
GOOGLE_TTS_VOICE=

AZURE_SPEECH_KEY=
# e.g. centralindia
AZURE_SPEECH_REGION=
# e.g. hi-IN-SwaraNeural (optional default)
AZURE_TTS_VOICE=

ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# voice_id (optional default)
ELEVENLABS_TTS_VOICE=

DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en  # Aura voice = model name

# --- LLM provider (text-only JSON completions: caller brain, judge, scenario gen, role detect, ASR intent)
LLM_PROVIDER=deepseek                # deepseek (default) | gemini
JUDGE_TEMPERATURE=0
CALLER_TEMPERATURE=0.7

# These are the defaults. A project can override them from the API (PUT /settings/llm, admin key):
# the project's provider, models and key win over everything below, and changes apply without a restart.
# DESIGNER_TEMPERATURE / *_DESIGNER_MODEL are for the test designer chat (default model: the judge model).
DESIGNER_TEMPERATURE=0.2

# DeepSeek (OpenAI-compatible API; model IDs per api-docs.deepseek.com, checked 2026-10-23)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_JUDGE_MODEL=deepseek-v4-pro     # judge, role detection, ASR intent (thinking is disabled so temperature 0 applies)
DEEPSEEK_CALLER_MODEL=deepseek-flash     # caller brain and scenario generation (cheaper, faster)
DEEPSEEK_DESIGNER_MODEL=                 # test designer chat (empty = the judge model)

# Gemini (supported alternative: set LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# pin an exact model ID; never a "latest" alias
GEMINI_JUDGE_MODEL=
# can be the same model, or a cheaper one
GEMINI_CALLER_MODEL=

# --- Ollama (self-hosted embeddings or prompt-agent models) ------------------------------
# Where provider "ollama" goes when a config gives no base_url. docker-compose.yml defaults
# it to its own `ollama` container (start it with: docker compose --profile ollama up -d;
# it pulls OLLAMA_PULL, default qwen3-embedding:0.6b). For an Ollama installed on the host
# use http://host.docker.internal:11434/v1 instead. This one server is trusted (plain http,
# private address) without AGENT_LLM_ALLOW_PRIVATE_URLS, and a local-only knowledge base may
# embed with it. Any other private endpoint you type in the app needs that flag.
OLLAMA_BASE_URL=
OLLAMA_PULL=qwen3-embedding:0.6b

# --- Kafka (event backbone) -----------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9094       # inside compose: kafka:9092
TOPIC_PARTITIONS=6
TOPIC_RETENTION_HOURS=168

# --- Network exposure (docker compose) --------------------------------------------------
# Published ports (Postgres, Kafka, API, web, mock agent, Kafka UI) bind to loopback by default.
# BIND_HOST=0.0.0.0 exposes them to your network; Postgres and Kafka have default/no credentials,
# so only do that behind a firewall or reverse proxy, and set POSTGRES_PASSWORD (URL-safe characters,
# set before the first start: an existing pg-data volume keeps its old password) and
# KAFKA_ADVERTISED_HOST (the address remote Kafka clients use) first.
BIND_HOST=127.0.0.1
# Local-only default; change it if BIND_HOST is not loopback.
POSTGRES_PASSWORD=pareeksha
KAFKA_ADVERTISED_HOST=localhost

# --- Database & storage --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://pareeksha:pareeksha@localhost:5432/pareeksha
DATA_DIR=./data/runtime

# --- Workers & runs -------------------------------------------------------------------
SIMULATOR_REPLICAS=3                         # compose replicas; must be <= TOPIC_PARTITIONS
EVALUATOR_REPLICAS=2
MAX_ATTEMPTS=3                               # then DLQ

# --- Budget / cost (fill COST_* after measuring on Day 1) ----------------------------
BUDGET_CREDITS=5000
COST_TTS_PER_1K_CHARS=
COST_STT_STREAM_PER_MIN=
COST_STT_REST_PER_MIN=
COST_STT_BATCH_PER_MIN=
COST_GOOGLE_TTS_PER_1K_CHARS=
COST_GOOGLE_STT_PER_MIN=
COST_AZURE_TTS_PER_1K_CHARS=
COST_AZURE_STT_PER_MIN=
COST_ELEVENLABS_TTS_PER_1K_CHARS=
COST_ELEVENLABS_STT_PER_MIN=
COST_DEEPGRAM_TTS_PER_1K_CHARS=
COST_DEEPGRAM_STT_PER_MIN=
# per-model list prices ($/1M tokens, cache miss, peak): flash 0.30 in / 1.20 out; v4-pro 1.32 in / 3.96 out
COST_DEEPSEEK_PER_1K_INPUT_TOKENS=
COST_DEEPSEEK_PER_1K_OUTPUT_TOKENS=
COST_GEMINI_PER_1K_INPUT_TOKENS=
COST_GEMINI_PER_1K_OUTPUT_TOKENS=

# --- Security --------------------------------------------------------------------------
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED by api + integrations worker (worker exits at startup without it); `make demo` generates one if empty
SECRET_KEY=

# --- API -------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:3000        # web app address: deep links in CRM notes
# public address of the API (inbound webhook URL shown in the Integrations UI); defaults to http://localhost:$API_HOST_PORT
PUBLIC_API_URL=http://localhost:8000

# --- Web app (Next.js, server-side only) ---------------------------------------------------
PAREEKSHA_API_URL=http://api:8000/api/v1     # web server → API (never exposed to the browser)
# created by `make demo`
PAREEKSHA_API_KEY=
# REQUIRED, no default: signs the sign-in session cookie. 16+ random characters: openssl rand -hex 32
# (`make demo` generates one if empty). The first visit to /login creates the admin account.
SESSION_SECRET=

# --- Integrations (optional, for local testing of the HubSpot sink) -------------------------
# only used by the connector's live test; normal tokens are stored encrypted per integration
HUBSPOT_TEST_PRIVATE_APP_TOKEN=

# --- Mock agent ---------------------------------------------------------------------------
MOCK_AGENT_PORT=8765
# Agents under test may live on private addresses (localhost, the bundled mock agent). Set false when hosting
# Pareeksha for others. Link-local and cloud-metadata addresses are refused either way.
AGENT_ALLOW_PRIVATE_ENDPOINTS=true
# comma list: no_disclosure,no_amount_confirm,english_to_kannada,ignore_interrupt,false_waiver
MOCK_BUGS=

# --- Logging ------------------------------------------------------------------------------
LOG_LEVEL=INFO
